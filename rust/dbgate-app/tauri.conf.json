{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DbGate",
  "version": "0.1.0",
  "identifier": "org.dbgate",
  "build": {
    "beforeDevCommand": "yarn --cwd ../../packages/web dev",
    "devUrl": "http://localhost:5001",
    "beforeBuildCommand": "yarn --cwd ../../packages/web build",
    "frontendDist": "../../packages/web/public"
  },
  "app": {
    "windows": [
      {
        "title": "DbGate",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
